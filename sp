 if(view==='districts'||view==='regions'){const geos=ELECTION[view];for(const geo of geos){const r=by.get(geo.id);if(!r)continue;const node=cSvg('path',{d:geo.d,fill:cPaint(r),class:'cDistrict','fill-rule':'evenodd'});cInteractive(node,r);svg.appendChild(node);if(view==='regions'){const label=cSvg('text',{x:geo.label[0],y:geo.label[1],class:'cMapCaption','text-anchor':'middle'});label.textContent=geo.name;svg.appendChild(label);}}}
 else {for(const geo of ELECTION.districts)svg.appendChild(cSvg('path',{d:geo.d,class:'cBase','aria-hidden':'true','fill-rule':'evenodd'}));for(const r of C_ROWS){for(const p of r.points){const active=!c$('cTerritory').value||r.id===c$('cTerritory').value;const node=cSvg('circle',{cx:p.point[0],cy:p.point[1],r:active?3.5:2.2,fill:cPaint(r),class:'cLocal'});cInteractive(node,r,false);const title=node.children[0];if(title)title.textContent+=' Local: '+p.name+' (zona '+p.z+', local '+p.l+').';svg.appendChild(node);}}}
 svg.setAttribute('viewBox',C_BOX.join(' '));const selected=cActive();c$('cMapCoverage').textContent=`${fmt(selected.located)} de ${fmt(selected.locais)} locais com posição validada no recorte. No município, 10 locais com 483 votos válidos permanecem sem posição no mapa; seus votos estão incluídos nos resultados.`;
 if(metric==='winner')c$('cLegend').innerHTML=[['Lula',C_RED],['Flávio Bolsonaro',C_BLUE],['Outro candidato',C_GRAY],['Empate em votos','#a4a6ae'],['Sem votos válidos / fora da seleção','#e3e7eb']].map(([l,c])=>`<span><i style="background:${c}"></i>${l}</span>`).join('');else {const code=metric==='lula'?13:22;c$('cLegend').innerHTML=[0,20,40,60,80].map(lo=>`<span><i style="background:${cRamp(lo,code)}"></i>${lo}% a ${lo+20}% dos válidos</span>`).join('')+'<span><i style="background:#e3e7eb"></i>Sem votos válidos / fora da seleção</span>';}}
function cTable(){const q=norm(c$('cSearch').value);C_TABLE=cSelectedRows().filter(r=>norm(r.id+' '+r.label+' '+r.regions.join(' ')).includes(q));const start=C_PAGE*50,part=C_TABLE.slice(start,start+50);c$('cTbody').innerHTML=part.length?part.map(r=>'<tr>'+[r.label,r.regions.join(' / '),fmt(r.secoes),fmt(cSum(r.v)),fmt(r.v[C_LULA]),pct(cPercent(r.v,C_LULA)),fmt(r.v[C_FLAVIO]),pct(cPercent(r.v,C_FLAVIO)),fmt(cSum(r.v)-r.v[C_LULA]-r.v[C_FLAVIO]),cWinner(r.v).label].map(x=>'<td>'+esc(x)+'</td>').join('')+'</tr>').join(''):'<tr><td colspan="10" class="empty">Nenhum território para esta busca.</td></tr>';c$('cRowsInfo').textContent=C_TABLE.length?`${fmt(start+1)}–${fmt(Math.min(start+50,C_TABLE.length))} de ${fmt(C_TABLE.length)} territórios`:'0 territórios';c$('cPrev').disabled=C_PAGE===0;c$('cNext').disabled=start+50>=C_TABLE.length;}
function cRender(){C_PAGE=0;cCards();cDrawMap();cTable();}
function cExport(){const header=['Recorte','Identificador','Territorio','Regioes','Secoes','Locais','Locais_geolocalizados','Votos_validos','Lula_votos','Lula_pct_validos','Flavio_votos','Flavio_pct_validos','Demais_votos','Mais_votado'];const rows=C_TABLE.map(r=>[C_VIEW[c$('cView').value].label,r.id,r.label,r.regions.join(' / '),r.secoes,r.locais,r.located,cSum(r.v),r.v[C_LULA],cPercent(r.v,C_LULA),r.v[C_FLAVIO],cPercent(r.v,C_FLAVIO),cSum(r.v)-r.v[C_LULA]-r.v[C_FLAVIO],cWinner(r.v).label]);const quote=v=>'"'+String(v??'').replace(/"/g,'""')+'"';const blob=new Blob(['\ufeff'+[header,...rows].map(r=>r.map(quote).join(';')).join('\r\n')],{type:'text/csv;charset=utf-8'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='Resultados_Candidatos_SP_2026_'+c$('cView').value+'.csv';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);}
function cZoom(f,px=.5,py=.5){const old=[...C_BOX],nw=Math.max(105,Math.min(1680,old[2]*f)),nh=nw*960/840;C_BOX=[old[0]+old[2]*px-nw*px,old[1]+old[3]*py-nh*py,nw,nh];c$('cMap').setAttribute('viewBox',C_BOX.join(' '));}
c$('cView').onchange=()=>{C_ROWS=cGroup(c$('cView').value);C_BOX=[0,0,840,960];c$('cSearch').value='';cOptions();cRender();};c$('cTerritory').onchange=cRender;c$('cMetric').onchange=cDrawMap;c$('cSearch').oninput=()=>{C_PAGE=0;cTable();};c$('cReset').onclick=()=>{c$('cTerritory').value='';c$('cSearch').value='';C_BOX=[0,0,840,960];cRender();};c$('cPrev').onclick=()=>{C_PAGE--;cTable();};c$('cNext').onclick=()=>{C_PAGE++;cTable();};c$('cDownload').onclick=cExport;c$('cZoomIn').onclick=()=>cZoom(.65);c$('cZoomOut').onclick=()=>cZoom(1/.65);c$('cFit').onclick=()=>{C_BOX=[0,0,840,960];c$('cMap').setAttribute('viewBox',C_BOX.join(' '));};
c$('cMap').onpointerdown=e=>{if(e.button!==0)return;C_DRAG={x:e.clientX,y:e.clientY,box:[...C_BOX]};C_MOVED=false;};c$('cMap').onpointermove=e=>{if(!C_DRAG)return;const dx=e.clientX-C_DRAG.x,dy=e.clientY-C_DRAG.y;if(Math.abs(dx)+Math.abs(dy)>6){C_MOVED=true;c$('cMap').classList.add('dragging');const rect=c$('cMap').getBoundingClientRect();C_BOX=[C_DRAG.box[0]-dx/rect.width*C_DRAG.box[2],C_DRAG.box[1]-dy/rect.height*C_DRAG.box[3],C_DRAG.box[2],C_DRAG.box[3]];c$('cMap').setAttribute('viewBox',C_BOX.join(' '));}};c$('cMap').onpointerup=()=>{C_DRAG=null;c$('cMap').classList.remove('dragging');};c$('cMap').onpointerleave=()=>{C_DRAG=null;c$('cMap').classList.remove('dragging');cDetail(cActive());};
function cShowPane(which){const votes=which!=='participacao';c$('candidatePane').hidden=!votes;c$('participationPane').hidden=votes;c$('navCandidates').setAttribute('aria-pressed',String(votes));c$('navParticipation').setAttribute('aria-pressed',String(!votes));try{history.replaceState(null,'',votes?'#votacao':'#participacao');}catch{}}
c$('navCandidates').onclick=()=>cShowPane('votacao');c$('navParticipation').onclick=()=>cShowPane('participacao');
const cMunicipalTotal=cSum(ELECTION.municipal);c$('cCityBars').innerHTML=[[C_LULA,'Lula',C_RED],[C_FLAVIO,'Flávio Bolsonaro',C_BLUE],[-1,'Demais candidatos',C_GRAY]].map(([i,l,c])=>{const value=i<0?cMunicipalTotal-ELECTION.municipal[C_LULA]-ELECTION.municipal[C_FLAVIO]:ELECTION.municipal[i];return `<div class="cCityRow"><div class="cCityLabel"><span>${l}</span><span>${pct(value/cMunicipalTotal*100)}</span></div><div class="cCityTrack"><div class="cCityFill" style="background:${c};width:${value/cMunicipalTotal*100}%"></div></div></div>`;}).join('');
C_ROWS=cGroup(c$('cView').value);cOptions();cRender();cShowPane(window.location.hash==='#participacao'?'participacao':'votacao');

</script></body></html>
